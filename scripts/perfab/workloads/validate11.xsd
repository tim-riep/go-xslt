<!-- XSD 1.1 validation of the 37 MB document: assertions, a key/keyref pair and a unique constraint -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="orders">
    <xs:complexType><xs:sequence>
      <xs:element name="order" maxOccurs="unbounded">
        <xs:complexType><xs:sequence>
          <xs:element name="customer" type="xs:string"/>
          <xs:element name="date" type="xs:date"/>
          <xs:element name="price" type="xs:decimal"/>
          <xs:element name="items"><xs:complexType><xs:sequence>
            <xs:element name="item" maxOccurs="unbounded"><xs:complexType>
              <xs:attribute name="sku" type="xs:string" use="required"/>
              <xs:attribute name="qty" type="xs:positiveInteger" use="required"/>
              <xs:assert test="@qty le 9 and starts-with(@sku, 's')"/>
            </xs:complexType></xs:element>
          </xs:sequence></xs:complexType></xs:element>
        </xs:sequence><xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:assert test="price ge 0 and year-from-date(date) = 2024 and count(items/item) ge 1"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence></xs:complexType>
    <xs:key name="orderId"><xs:selector xpath="order"/><xs:field xpath="@id"/></xs:key>
    <xs:unique name="orderIdCustomer"><xs:selector xpath="order"/><xs:field xpath="@id"/><xs:field xpath="customer"/></xs:unique>
    <xs:keyref name="orderRef" refer="orderId"><xs:selector xpath="order"/><xs:field xpath="@id"/></xs:keyref>
  </xs:element>
</xs:schema>
